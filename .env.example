

BEARER_TOKEN = "Your_Spotify_Bearer_Token_Here"
SPOTIFY_ACCESS_TOKEN =
DATABASE_URL = "postgresql://postgres:postgres@localhost:5432/postgres"

# Copy to .env before starting:  cp .env.example .env   (.env is ignored by git)
# Simple passwords are for local development only.

# --- Image versions (pinned) ---
POSTGRES_VERSION=16.4
AIRFLOW_VERSION=2.8.1
# dbt installed into its own virtualenv in the image.
# TODO: pin once the dbt owner confirms the version, e.g. dbt-postgres==1.x.y
DBT_POSTGRES_SPEC=dbt-postgres

# --- Linux user id for the containers: run `id -u` and put the number here ---
AIRFLOW_UID=

# --- Airflow metadata database ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# --- Warehouse database ---
WAREHOUSE_DB_USER=warehouse
WAREHOUSE_DB_PASSWORD=warehouse
WAREHOUSE_DB_NAME=warehouse
WAREHOUSE_DB_PORT=5433        # port on YOUR computer (inside Docker it is 5432)

# --- Airflow web UI login (http://localhost:8080) ---
AIRFLOW_WEB_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Airflow secrets ---
# The Fernet key must be a valid key (32 random bytes, url-safe base64), not a simple word.
# Dev-only placeholder shared by the team; generate your own for anything real:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=zZ9S9VEIsoQoznTp-Iu3IdvKD_bqfqHnzcabjE_Vzgs=
AIRFLOW_WEBSERVER_SECRET_KEY=secret

# --- Loaders run on your own machine (outside Docker) ---
# Containers ignore this and use their own DATABASE_URL pointing at warehouse-db.
DATABASE_URL=postgresql://warehouse:warehouse@localhost:5433/warehouse

# --- Spotify Web API (track metadata) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Spotify Charts token (from your README: SPOTIFY_CHARTS_TOKEN or the older BEARER_TOKEN) ---
# Use only one of the two and delete the other line; it expires and must be renewed.
SPOTIFY_CHARTS_TOKEN=

# --- KaggleHub (only if Kaggle requires sign-in for the backfill) ---
# KAGGLE_USERNAME=
# KAGGLE_KEY=